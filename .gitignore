# Dados de mídia e cache (nunca versionar)
data/
*.mkv
*.mp4
*.mov
*.wav

# Exceção: assets do brand kit são versionados (migrar para Git LFS se crescerem)
!packages/brand-kit/**

# Exceção: amostras reais pequenas para testes (poucos MB). Fixtures sintéticas e clipes do kit de teste do
# Resolve não são versionados: são gerados por script em cada máquina, em data/fixtures/ (nunca nesta pasta).
!services/engine/tests/fixtures/**

# Configuração: dev.yaml/prod.yaml são versionados; caminhos de cada máquina ficam nos *.local.yaml
config/*.local.yaml

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/
dist/

# Ambiente e IDE
.env
.env.*
!.env.example
.vscode/
.idea/
*.log
Thumbs.db
.DS_Store

# Claude Code (configurações locais da máquina)
.claude/settings.local.json
